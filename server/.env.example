# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Secret used to sign JWT auth tokens. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-long-random-secret

# Port the server listens on (optional; defaults to 5000).
PORT=5000

# Allowed frontend origin(s) for CORS in production.
# Comma-separated for multiple. Leave unset in local dev to allow all.
# Example: https://your-app.vercel.app
CLIENT_ORIGIN=
