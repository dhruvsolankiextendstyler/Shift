# Base URL of the SHIFT backend API, including the /api prefix.
# Local dev example:
VITE_API_URL=http://localhost:5000/api

# Production example (Render backend):
# VITE_API_URL=https://your-backend.onrender.com/api

# Google OAuth Client ID (must match the Client ID configured on Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

